{
  "name": "rewind-desktop",
  "productName": "Rewind",
  "version": "1.2.0-rc.4",
  "description": "Lightweight OBS replay buffer - save the last 60 seconds of your screen & more",
  "main": "out/main/index.js",
  "author": {
    "name": "Rewind",
    "url": "https://github.com/bulhaa1/Rewind"
  },
  "license": "GPL-2.0-or-later",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.js",
    "build:main": "node scripts/build-main.js",
    "build:renderer": "node node_modules/vite/bin/vite.js build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && node node_modules/electron/cli.js .",
    "rebuild": "node node_modules/@electron/rebuild/lib/src/cli.js -f -w @streamlabs/obs-studio-node,uiohook-napi,get-windows,native-sound-mixer,koffi",
    "package": "npm run build && node node_modules/electron-builder/out/cli/cli.js --win --publish never && npm run package:stamp",
    "package:stamp": "node scripts/stamp-exe.mjs && node node_modules/electron-builder/out/cli/cli.js --win nsis --prepackaged release/win-unpacked --publish never",
    "package:verify-exe": "node scripts/verify-exe.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "verify:channels": "node scripts/channel-check.mjs",
    "icons": "npm run icons:extract && npm run icons:sizes && node scripts/gen-ico.mjs && npm run icons:review",
    "icons:extract": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/logo-extract.ps1",
    "icons:sizes": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/logo-sizes.ps1",
    "icons:review": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/logo-contact-sheet.ps1",
    "palette": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/logo-palette.ps1 && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/logo-palette-sheet.ps1",
    "selftest": "node scripts/selftest.js",
    "test:display": "node scripts/displaytest.js",
    "test:resolution": "node scripts/probe-resolution-change.mjs",
    "test:update-cache": "node scripts/probe-update-cache.mjs",
    "test:update": "node scripts/probe-update.mjs",
    "test:profiles": "node scripts/probe-profiles-selftest.mjs",
    "test:ui": "node scripts/cdp.mjs scripts/probe-regression.mjs",
    "test:quickclip": "node scripts/probe-quick-clip.mjs",
    "release": "npm run package && node node_modules/electron-builder/out/cli/cli.js --win nsis --prepackaged release/win-unpacked --publish always && node scripts/verify-exe.mjs",
    "release:local": "npm run build && node node_modules/electron-builder/out/cli/cli.js --win --publish never && npm run package:stamp"
  },
  "dependencies": {
    "@streamlabs/obs-studio-node": "https://s3-us-west-2.amazonaws.com/obsstudionodes3.streamlabs.com/osn-0.25.77-release-win64.tar.gz",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.2.0",
    "get-windows": "^9.3.0",
    "koffi": "^3.3.3",
    "native-sound-mixer": "^3.4.6-win",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@base-ui-components/react": "^1.0.0-rc.0",
    "@electron/rebuild": "^4.2.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource-variable/orbitron": "^5.3.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-virtual": "^3.14.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "clsx": "^2.1.1",
    "electron": "30.5.1",
    "electron-builder": "^25.1.8",
    "ffprobe-static": "^3.1.0",
    "lucide-react": "^0.454.0",
    "motion": "^14.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bulhaa1/Rewind.git"
  },
  "homepage": "https://github.com/bulhaa1/Rewind"
}
